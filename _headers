# =====================================================================
#  _headers — Hype · règles de cache Netlify
#  A placer à la RACINE du dépôt, à côté de index.html
#  (pas d'extension, l'underscore compte)
#
#  Principe : ce qui ne change JAMAIS est mis en cache un an ;
#             ce qui change à chaque push n'est jamais mis en cache.
# =====================================================================


# ---------------------------------------------------------------------
#  JAMAIS EN CACHE — sinon un push ne parviendrait pas aux utilisateurs
# ---------------------------------------------------------------------

/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/lingo.html
  Cache-Control: public, max-age=0, must-revalidate

/lingo-globe.html
  Cache-Control: public, max-age=0, must-revalidate

/hype-cours-baby.js
  Cache-Control: public, max-age=0, must-revalidate

/hype-memory-poney.js
  Cache-Control: public, max-age=0, must-revalidate

# Galops 4 a 7, sortis de l'index le 06/09 (session galops-sup). Meme recette
# que hype-cours-baby.js : jamais en cache, et une adresse neuve (?v=N) a
# chaque livraison — c'est le ?v= qui compte pour l'app installee.
/hype-cours-galops-sup.js
  Cache-Control: public, max-age=0, must-revalidate

# Galop 3, sorti de l'index le 06/09 (nuit) — meme regle.
/hype-cours-galop3.js
  Cache-Control: public, max-age=0, must-revalidate

# Les quatre autres modules charges avec un ?v= (stories, resultats, import
# FFE, modeles) : meme ceinture, ajoutee le 06/09 a la demande de Blandine.
/hype-stories.js
  Cache-Control: public, max-age=0, must-revalidate

/hype-resultats.js
  Cache-Control: public, max-age=0, must-revalidate

/hype-import-ffe.js
  Cache-Control: public, max-age=0, must-revalidate

/hype-modeles-db.js
  Cache-Control: public, max-age=0, must-revalidate


# ---------------------------------------------------------------------
#  CACHE UN AN, IMMUABLE — contenus adressés par clé, jamais réécrits :
#  119 fichiers d'images + 3 fichiers de la base de clubs.
#  C'est ici que se trouve l'essentiel du gain.
# ---------------------------------------------------------------------

/hype-images-*.js
  Cache-Control: public, max-age=31536000, immutable

/hype-clubs-db-*.js
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=31536000, immutable

# Les 98 images du Memory du Poney (session 113, 11/08) vivent A LA RACINE et
# non dans images/ : aucune regle ne les couvrait, le navigateur les
# renegociait donc a chaque ouverture d'un niveau — d'ou le lag constate par
# Blandine. Leur nom porte deja ?v=N et change quand l'image change.
# Le jour du rangement en medias/baby/, garder cette ligne le temps que les
# anciens chemins disparaissent des caches, puis la retirer.
/memory-*.webp
  Cache-Control: public, max-age=31536000, immutable

# Prepare le rangement en cinq dossiers (doctrine du 11/08) : medias/baby,
# medias/galops, medias/linguae, medias/hype. Que du WebP, jamais reecrit.
/medias/*
  Cache-Control: public, max-age=31536000, immutable

